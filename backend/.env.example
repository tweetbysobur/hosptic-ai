# Hosptic AI backend configuration. Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Runtime connection: the restricted role (hosptic_app). RLS applies to it.
DATABASE_URL=postgresql://hosptic_app:CHANGE_ME@localhost:5432/hosptic
# Migrations only: the schema owner role (hosptic_owner).
DIRECT_URL=postgresql://hosptic_owner:CHANGE_ME@localhost:5432/hosptic

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:3000
# lax works when frontend and API share a site. Use none (forces Secure) for different sites.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Set to true behind a reverse proxy or load balancer.
TRUST_PROXY=false

# Z.ai (https://docs.z.ai). Leave ZAI_API_KEY empty to run without external AI.
ZAI_API_KEY=
ZAI_API_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
ZAI_TIMEOUT_MS=60000

# Private S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...).
# STORAGE_DRIVER=local is for development only and is refused in production.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_LOCAL_DIR=./.storage
SIGNED_URL_TTL_SECONDS=300
# Public base URL of this API, used to build local-driver download links.
PUBLIC_API_URL=

MAX_UPLOAD_MB=10
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=300

# Serve Swagger UI at /api/docs in production.
ENABLE_API_DOCS=false
