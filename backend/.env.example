# Copy to backend/.env for local development. Never commit real values.

# Runtime connection. Use the restricted hosptic_app role (see sql/create-app-role.sql).
DATABASE_URL=postgresql://hosptic_app:<password>@localhost:5432/hosptic
# Owner connection for prisma migrate only.
DIRECT_URL=postgresql://<owner>:<password>@localhost:5432/hosptic

NODE_ENV=development
PORT=4000

# At least 32 characters each. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookie policy. Use COOKIE_SAMESITE=none and COOKIE_SECURE=true when the frontend is on another site.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Z.ai. Leave ZAI_API_KEY empty to disable AI features. Confirm ZAI_MODEL in the Z.ai model list.
ZAI_API_KEY=
ZAI_API_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=
ZAI_TIMEOUT_MS=60000

# Private object storage. local stores files under STORAGE_LOCAL_DIR for development only.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=0
