// Hosptic AI data model.
// Every hospital-owned table carries organizationId and is protected by
// PostgreSQL row-level security (see migrations/*_rls). The application
// connects as the restricted role in DATABASE_URL. Migrations run as the
// owner role in DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZATION_ADMIN
  RESEARCHER
  ANALYST
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum DatasetStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

model Organization {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String    @unique
  email                 String
  aiProcessingEnabled   Boolean   @default(false)
  aiProcessingUpdatedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships     Membership[]
  datasets        Dataset[]
  datasetColumns  DatasetColumn[]
  transformations DatasetTransformation[]
  analyses        Analysis[]
  analysisResults AnalysisResult[]
  reports         Report[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  email        String   @unique
  // Null until an invited user accepts and sets a password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  datasets        Dataset[]               @relation("DatasetUploader")
  analyses        Analysis[]
  reports         Report[]
  auditLogs       AuditLog[]
  transformations DatasetTransformation[]

  @@map("users")
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  userId          String           @db.Uuid
  role            Role
  status          MembershipStatus @default(ACTIVE)
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?
  invitedById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// Refresh-token sessions. Only a hash of the token id is stored.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  membershipId String    @db.Uuid
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Dataset {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  uploadedById     String?       @db.Uuid
  name             String
  description      String?
  originalFileName String
  storageKey       String
  // Latest processed version, when cleaning has been applied. Original is never overwritten.
  processedStorageKey String?
  fileType         String
  fileSize         Int
  rowCount         Int?
  columnCount      Int?
  status           DatasetStatus @default(UPLOADED)
  qualityReport    Json?
  errorMessage     String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy      User?                   @relation("DatasetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  columns         DatasetColumn[]
  transformations DatasetTransformation[]
  // Restrict: a dataset with analyses is soft-deleted, never hard-deleted.
  analyses        Analysis[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@map("datasets")
}

model DatasetColumn {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  datasetId      String  @db.Uuid
  position       Int
  columnName     String
  inferredType   String
  missingCount   Int
  uniqueCount    Int
  isSensitive    Boolean @default(false)
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite key: a column can only belong to a dataset of the same organisation.
  dataset      Dataset      @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([datasetId, columnName])
  @@index([organizationId])
  @@map("dataset_columns")
}

// Every cleaning run creates a new processed version and is recorded here.
model DatasetTransformation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  datasetId        String   @db.Uuid
  appliedById      String?  @db.Uuid
  operations       Json
  summary          Json
  inputStorageKey  String
  outputStorageKey String
  rowCountBefore   Int
  rowCountAfter    Int
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      Dataset      @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Cascade)
  appliedBy    User?        @relation(fields: [appliedById], references: [id], onDelete: SetNull)

  @@index([organizationId, datasetId])
  @@map("dataset_transformations")
}

model Analysis {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  datasetId          String         @db.Uuid
  userId             String?        @db.Uuid
  question           String
  analysisType       String?
  plan               Json?
  planSource         String?
  sourceStorageKey   String?
  status             AnalysisStatus @default(PENDING)
  errorMessage       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      Dataset         @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: NoAction)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  result       AnalysisResult?
  reports      Report[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([datasetId])
  @@map("analyses")
}

model AnalysisResult {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  analysisId           String   @unique @db.Uuid
  methodology          Json
  statisticalResults   Json
  interpretation       String
  interpretationSource String
  visualizationData    Json?
  assumptions          Json
  limitations          Json
  createdAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analysis     Analysis     @relation(fields: [analysisId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([analysisId, organizationId])
  @@index([organizationId])
  @@map("analysis_results")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  analysisId     String       @db.Uuid
  generatedById  String?      @db.Uuid
  title          String
  storageKey     String?
  status         ReportStatus @default(PENDING)
  errorMessage   String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analysis     Analysis     @relation(fields: [analysisId, organizationId], references: [id, organizationId], onDelete: NoAction)
  generatedBy  User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("reports")
}

// Append-only. The application role has no UPDATE or DELETE grant here.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
