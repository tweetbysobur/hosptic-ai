{
  "name": "hosptic-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hosptic AI backend API (Express, Prisma, PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:app-role": "psql \"$DIRECT_URL\" -v app_password=\"'$APP_DB_PASSWORD'\" -f sql/create-app-role.sql",
    "test:live": "ZAI_LIVE=1 jest --runInBand --forceExit tests/live"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "danfojs-node": "^1.2.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jstat": "^1.9.6",
    "multer": "^2.5.0",
    "papaparse": "^5.7.1",
    "pdfkit": "^0.15.2",
    "simple-statistics": "^8.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "s3rver": "^3.7.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 60000,
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
