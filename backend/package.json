{
  "name": "hosptic-ai-backend",
  "version": "0.1.0",
  "description": "Hosptic AI backend API",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:roles": "psql \"$DIRECT_URL\" -f scripts/setup-db-roles.sql",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "docs:export": "node scripts/export-openapi.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jstat": "^1.9.6",
    "multer": "^2.5.0",
    "papaparse": "^5.7.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "simple-statistics": "^8.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "testTimeout": 30000
  }
}
